<div class="min-h-screen w-full flex flex-col items-center justify-center py-10 font-sans text-slate-800 bg-gradient-to-br from-indigo-50 to-white">
  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl p-10 border border-indigo-50">
    <h1 class="text-4xl font-extrabold text-center text-indigo-900 mb-2 tracking-wider">ビンゴマシーン</h1>
    <p class="text-center text-slate-500 mb-10 text-sm">Create your new Bingo Party!</p>

    <%= form_with url: games_path, method: :post, local: true, class: "flex flex-col gap-6" do |f| %>
      <div>
        <%= f.label :password, "パスワード（任意）", class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= f.password_field :password, class: "w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none", placeholder: "操作を制限する場合に入力" %>
        <p class="text-xs text-slate-400 mt-2">※パスワードを設定すると、抽選・リセット操作に認証が必要になります。</p>
      </div>

      <%= f.submit "新しいゲームを作成", class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white text-xl font-bold py-4 rounded-xl shadow-lg transition-transform active:scale-95 cursor-pointer mt-4" %>
    <% end %>
  </div>
</div>
