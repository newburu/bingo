<div class="min-h-screen w-full font-sans text-slate-800 bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50">
  
  <!-- Hero Section -->
  <header class="container mx-auto px-6 py-16 md:py-24 flex flex-col items-center text-center">
    <div class="inline-block px-4 py-1.5 rounded-full bg-indigo-100 text-indigo-700 text-sm font-bold tracking-wide mb-6 shadow-sm">
      ✨ 登録不要・完全無料
    </div>
    <h1 class="text-5xl md:text-7xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600 mb-6 drop-shadow-sm tracking-tight leading-tight">
      アプリ不要。<br class="md:hidden" />URLだけで、<br />そこがビンゴ会場。
    </h1>
    <p class="text-lg md:text-xl text-slate-600 mb-10 max-w-2xl leading-relaxed">
      もう専用のマシーンも、アプリのインストールも必要ありません。<br />
      スマホひとつで、誰でもすぐにビンゴ大会を始められます。
    </p>
    
    <div class="w-full max-w-md bg-white/80 backdrop-blur-md rounded-3xl shadow-2xl p-8 border border-white/50 relative overflow-hidden group hover:scale-[1.02] transition-transform duration-300">
      <div class="absolute -top-10 -right-10 w-32 h-32 bg-indigo-100 rounded-full blur-3xl opacity-50 group-hover:opacity-100 transition-opacity"></div>
      
      <%= form_with url: games_path, method: :post, local: true, class: "flex flex-col gap-5 relative z-10" do |f| %>
        <h2 class="text-xl font-bold text-center text-indigo-900">さあ、パーティーを始めよう！</h2>
        <div>
          <%= f.password_field :password, class: "w-full px-5 py-4 rounded-xl border border-slate-200 bg-white/50 focus:bg-white focus:ring-4 focus:ring-indigo-100 focus:border-indigo-500 transition-all outline-none placeholder:text-slate-400 font-medium", placeholder: "合言葉（パスワード/任意）" %>
          <p class="text-[10px] text-slate-400 mt-2 text-center text-xs">※設定すると操作をロックできます</p>
        </div>

        <%= f.submit "新しいビンゴを作成する 🚀", class: "w-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white text-lg font-bold py-4 rounded-xl shadow-lg shadow-indigo-200 transition-all active:scale-95 cursor-pointer" %>
      <% end %>
    </div>
  </header>

  <!-- Features Section -->
  <section class="container mx-auto px-6 py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Feature 1 -->
      <div class="bg-white p-8 rounded-3xl shadow-lg shadow-slate-200/50 border border-slate-100 flex flex-col items-center text-center hover:translate-y-[-5px] transition-transform duration-300">
        <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center text-3xl mb-6">🔗</div>
        <h3 class="text-xl font-bold text-slate-800 mb-3">URLひとつで共有</h3>
        <p class="text-slate-500 leading-relaxed">発行されたURLを送るだけ。プロジェクターがなくても、みんなの手元がスクリーンになります。</p>
      </div>

      <!-- Feature 2 -->
      <div class="bg-white p-8 rounded-3xl shadow-lg shadow-slate-200/50 border border-slate-100 flex flex-col items-center text-center hover:translate-y-[-5px] transition-transform duration-300">
        <div class="w-16 h-16 bg-pink-100 text-pink-600 rounded-2xl flex items-center justify-center text-3xl mb-6">🎰</div>
        <h3 class="text-xl font-bold text-slate-800 mb-3">盛り上がる演出</h3>
        <p class="text-slate-500 leading-relaxed">ドラムロール音のようなドキドキ感のあるスロットアニメーションで、会場の一体感を作ります。</p>
      </div>

      <!-- Feature 3 -->
      <div class="bg-white p-8 rounded-3xl shadow-lg shadow-slate-200/50 border border-slate-100 flex flex-col items-center text-center hover:translate-y-[-5px] transition-transform duration-300">
        <div class="w-16 h-16 bg-orange-100 text-orange-600 rounded-2xl flex items-center justify-center text-3xl mb-6">🛡️</div>
        <h3 class="text-xl font-bold text-slate-800 mb-3">安心のロック機能</h3>
        <p class="text-slate-500 leading-relaxed">パスワードを設定すれば、参加者が誤ってリセットしてしまう事故を防げます。</p>
      </div>
    </div>
  </section>

  <!-- Usage Guide -->
  <section class="container mx-auto px-6 pb-32">
    <div class="relative">
      <!-- Background Elements -->
      <div class="absolute inset-0 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-[3rem] opacity-90 shadow-2xl skew-y-1 transform"></div>
      <div class="absolute -top-10 -right-10 w-40 h-40 bg-pink-400 rounded-full blur-3xl opacity-50"></div>
      <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-blue-400 rounded-full blur-3xl opacity-50"></div>

      <div class="relative bg-white/10 backdrop-blur-lg rounded-[3rem] p-8 md:p-16 text-white border border-white/20 overflow-hidden">
        <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-16 tracking-tight drop-shadow-md">
          たったの <span class="text-yellow-300">4ステップ</span>
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Step 1 -->
          <div class="group relative bg-white/10 hover:bg-white/20 transition-all duration-300 rounded-2xl p-6 border border-white/10 hover:border-white/30 hover:-translate-y-1 shadow-lg">
            <div class="absolute -top-4 -left-4 w-10 h-10 bg-yellow-400 text-indigo-900 rounded-xl flex items-center justify-center font-black text-xl shadow-md rotate-3 group-hover:rotate-6 transition-transform">1</div>
            <div class="h-16 flex items-center justify-center text-5xl mb-4 group-hover:scale-110 transition-transform duration-300">🆕</div>
            <h3 class="font-bold text-lg mb-2 text-center text-white">ゲーム作成</h3>
            <p class="text-indigo-100 text-sm text-center font-medium leading-relaxed">このページのボタンから<br>新しいゲームを開始</p>
          </div>
          
          <!-- Step 2 -->
          <div class="group relative bg-white/10 hover:bg-white/20 transition-all duration-300 rounded-2xl p-6 border border-white/10 hover:border-white/30 hover:-translate-y-1 shadow-lg">
            <div class="absolute -top-4 -left-4 w-10 h-10 bg-white text-indigo-600 rounded-xl flex items-center justify-center font-black text-xl shadow-md -rotate-2 group-hover:-rotate-6 transition-transform">2</div>
            <div class="h-16 flex items-center justify-center text-5xl mb-4 group-hover:scale-110 transition-transform duration-300">🔗</div>
            <h3 class="font-bold text-lg mb-2 text-center text-white">URLを共有</h3>
            <p class="text-indigo-100 text-sm text-center font-medium leading-relaxed">LINEやSlackで<br>参加者にURLを送信</p>
          </div>

          <!-- Step 3 -->
          <div class="group relative bg-white/10 hover:bg-white/20 transition-all duration-300 rounded-2xl p-6 border border-white/10 hover:border-white/30 hover:-translate-y-1 shadow-lg">
             <div class="absolute -top-4 -left-4 w-10 h-10 bg-white text-indigo-600 rounded-xl flex items-center justify-center font-black text-xl shadow-md rotate-2 group-hover:rotate-6 transition-transform">3</div>
            <div class="h-16 flex items-center justify-center text-5xl mb-4 group-hover:scale-110 transition-transform duration-300">🎰</div>
            <h3 class="font-bold text-lg mb-2 text-center text-white">抽選スタート</h3>
            <p class="text-indigo-100 text-sm text-center font-medium leading-relaxed">「回す！」ボタンで<br>数字を抽選</p>
          </div>

          <!-- Step 4 -->
          <div class="group relative bg-white/10 hover:bg-white/20 transition-all duration-300 rounded-2xl p-6 border border-white/10 hover:border-white/30 hover:-translate-y-1 shadow-lg">
             <div class="absolute -top-4 -left-4 w-10 h-10 bg-pink-400 text-white rounded-xl flex items-center justify-center font-black text-xl shadow-md -rotate-3 group-hover:-rotate-6 transition-transform">4</div>
            <div class="h-16 flex items-center justify-center text-5xl mb-4 group-hover:scale-110 transition-transform duration-300">👀</div>
            <h3 class="font-bold text-lg mb-2 text-center text-white">みんなで確認</h3>
            <p class="text-indigo-100 text-sm text-center font-medium leading-relaxed">出た数字は<br>全員の画面に即反映</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="text-center py-8 text-slate-400 text-sm">
    &copy; <%= Date.today.year %> Bingo Machine. All rights reserved.
  </footer>
</div>
