<div class="min-h-screen w-full flex flex-col items-center py-10 font-sans text-slate-800">
  
  <h1 class="text-5xl font-extrabold tracking-widest text-indigo-900 mb-8 drop-shadow-sm">BINGO MACHINE</h1>

  <!-- Current Number Display -->
  <div class="mb-10 text-center">
    <div class="text-gray-500 text-lg mb-2 font-medium tracking-wider">CURRENT NUMBER</div>
    <div class="text-[12rem] leading-none font-black text-indigo-600 drop-shadow-md tabular-nums">
      <%= @game.current_number || "START" %>
    </div>
    <% if @game.finished? %>
      <div class="text-3xl font-bold text-red-500 mt-4 animate-bounce">FINISHED!</div>
    <% end %>
  </div>

  <!-- Controls -->
  <div class="flex flex-col items-center gap-4 mb-12">
    <%= button_to "SPIN!", spin_games_path, method: :post, 
        disabled: @game.finished?,
        class: "bg-indigo-600 hover:bg-indigo-700 text-white text-3xl font-bold py-6 px-16 rounded-full shadow-xl transition-transform active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed uppercase tracking-wide" %>
    
    <%= button_to "Reset Game", reset_games_path, method: :post, form: { data: { turbo_confirm: "Are you sure?" } }, 
        class: "text-slate-400 hover:text-red-500 text-sm font-semibold tracking-wide uppercase transition-colors" %>
  </div>

  <!-- History Board -->
  <div class="bg-white rounded-3xl shadow-2xl p-8 max-w-4xl w-full border border-slate-100">
    <div class="grid grid-cols-5 gap-8">
      <% 
        columns = {
          'B' => (1..15),
          'I' => (16..30),
          'N' => (31..45),
          'G' => (46..60),
          'O' => (61..75)
        }
      %>

      <% columns.each do |letter, range| %>
        <div class="flex flex-col gap-3">
          <!-- Header -->
          <div class="text-5xl font-black text-center text-slate-200 mb-4 font-mono"><%= letter %></div>
          
          <!-- Numbers -->
          <% range.each do |num| %>
            <% is_hit = @game.history.include?(num) %>
            <% is_last = @game.current_number == num %>
            
            <div class="h-14 flex items-center justify-center rounded-xl text-xl font-bold transition-all duration-300 
              <%= is_last ? 'bg-amber-400 text-white scale-110 shadow-lg ring-4 ring-amber-200 z-10' : 
                  (is_hit ? 'bg-indigo-500 text-white shadow-md' : 'bg-slate-50 text-slate-300') %>">
              <%= num %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
