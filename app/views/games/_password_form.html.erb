<div id="controls" class="flex flex-col items-center gap-4 mb-12 w-full max-w-sm">
  <div class="bg-white p-6 rounded-2xl shadow-lg border border-slate-100 w-full">
    <h3 class="text-center text-lg font-bold text-slate-700 mb-4">
      <%= local_assigns[:message] || "このゲームはロックされています" %>
    </h3>
    
    <%= form_with url: auth_game_path(game), method: :post, local: true, class: "flex flex-col gap-4" do |f| %>
      <%= f.password_field :password, placeholder: "パスワードを入力", class: "w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none" %>
      <%= f.submit "認証解除", class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl transition-colors cursor-pointer" %>
    <% end %>
  </div>
</div>
